rules_version = '2';
// Browser tidak boleh membaca atau menulis Firestore secara langsung.
// Semua akses lewat server (folder api/) yang memakai akun layanan dan mengecek kode akses.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
